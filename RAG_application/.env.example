GOOGLE_API_KEY=your_google_api_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_app

# --- Security (set before Kubernetes / production deploy) ---
REQUIRE_AUTH=true
API_KEY=generate-a-long-random-secret-here
# Optional: Supabase JWT secret for multi-user auth (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=
DEV_USER_ID=dev-user

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://rag.yourdomain.com

# Rate limits
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=60/minute
